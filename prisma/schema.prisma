// مخطط قاعدة بيانات موقع فالكون

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(cuid())
  name      String
  phone     String
  city      String
  model     String
  createdAt DateTime @default(now())

  @@map("orders")
}

model NewsletterSub {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subs")
}
