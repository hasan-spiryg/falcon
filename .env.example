# ============================================================
# متغيرات البيئة لموقع فالكون — انسخ هذا الملف إلى .env واملأ القيم
#   cp .env.example .env
# ============================================================

# رابط قاعدة بيانات Neon (PostgreSQL)
# انسخه من لوحة Neon → Project → Connection String → اختر (Pooled)
# يبدأ عادة بـ: postgresql://user:pass@ep-xxx-pooler...neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-PPOOLER.REGION.AWS.NEON.TECH/NEONDB?sslmode=require"

# كلمة مرور الدخول إلى لوحة الإدارة (/admin)
# مهم: استخدم كلمة قوية وطويلة في الإنتاج
ADMIN_PASSWORD="ضع-كلمة-مرور-قوية-هنا"

# سر توقيع جلسات لوحة الإدارة — أي نص عشوائي طويل
ADMIN_SECRET="ضع-نصا-عشوائيا-طويلا-هنا"
